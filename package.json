{
  "name": "learning-kernel",
  "version": "0.1.0",
  "private": true,
  "description": "可复用的在线学习活动内核",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.19.x"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "coverage": "node scripts/run-tests.mjs --coverage",
    "check:size": "node scripts/check-size.mjs",
    "lint": "node scripts/lint.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run check:size && pnpm test",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/parser": "7.28.5",
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  }
}
